#!/bin/sh
set -eu

scan_seconds=${BLUETOOTH_SCAN_SECONDS:-8}
rofi_lines=${BLUETOOTH_ROFI_LINES:-12}
rofi_transition_delay=${BLUETOOTH_ROFI_TRANSITION_DELAY:-0.15}

notify() {
  if command -v dunstify >/dev/null 2>&1; then
    dunstify "$@"
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "$@"
  fi
}

die_rofi() {
  if command -v rofi >/dev/null 2>&1; then
    rofi -e "$1"
  else
    printf '%s\n' "$1" >&2
  fi
  exit 1
}

wait_for_rofi_transition() {
  [ "$rofi_transition_delay" = "0" ] || sleep "$rofi_transition_delay"
}

require_bluetoothctl() {
  command -v bluetoothctl >/dev/null 2>&1 || die_rofi "bluetoothctl is not installed. Install the bluetooth package."
}

controller_info() {
  bluetoothctl show 2>/dev/null || true
}

controller_powered() {
  controller_info | awk -F': ' '/^[[:space:]]*Powered:/ { print $2; exit }'
}

device_prop() {
  mac=$1
  prop=$2

  bluetoothctl info "$mac" 2>/dev/null \
    | awk -F': ' -v prop="$prop" '$1 ~ "^[[:space:]]*" prop "$" { print $2; exit }'
}

device_name() {
  mac=$1
  name=$(device_prop "$mac" "Name")
  [ -n "$name" ] || name=$(device_prop "$mac" "Alias")
  [ -n "$name" ] || name="Unknown device"
  printf '%s\n' "$name"
}

device_has_bond() {
  mac=$1
  paired=$(device_prop "$mac" "Paired")
  bonded=$(device_prop "$mac" "Bonded")

  [ "$paired" = "yes" ] || [ "$bonded" = "yes" ]
}

device_ready() {
  mac=$1
  connected=$(device_prop "$mac" "Connected")

  [ "$connected" = "yes" ] && device_has_bond "$mac"
}

device_state() {
  mac=$1
  connected=$(device_prop "$mac" "Connected")
  paired=$(device_prop "$mac" "Paired")
  bonded=$(device_prop "$mac" "Bonded")
  trusted=$(device_prop "$mac" "Trusted")

  printf 'Connected: %s\nPaired: %s\nBonded: %s\nTrusted: %s' \
    "${connected:-unknown}" \
    "${paired:-unknown}" \
    "${bonded:-unknown}" \
    "${trusted:-unknown}"
}

find_device_mac_by_name() {
  name=$1

  bluetoothctl devices 2>/dev/null \
    | awk -v wanted="$name" '
        /^Device[[:space:]]+([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}[[:space:]]+/ {
          mac = $2
          $1 = ""
          $2 = ""
          sub(/^[[:space:]]+/, "")
          if ($0 == wanted) {
            print mac
            exit
          }
        }'
}

run_bt() {
  label=$1
  shift

  output=$(bluetoothctl "$@" 2>&1) && {
    notify "Bluetooth" "$label"
    return 0
  }

  notify "Bluetooth failed" "$output"
  die_rofi "$output"
}

trust_device() {
  mac=$1

  output=$(bluetoothctl trust "$mac" 2>&1) || {
    notify "Bluetooth trust failed" "$output"
    return 1
  }
}

pair_device() {
  mac=$1
  name=$2

  bluetoothctl power on >/dev/null 2>&1 || true
  bluetoothctl pairable on >/dev/null 2>&1 || true

  if output=$(bluetoothctl --agent NoInputNoOutput --timeout 30 pair "$mac" 2>&1); then
    trust_device "$mac" >/dev/null 2>&1 || true
    return 0
  fi

  die_rofi "$(printf 'Pair failed for %s:\n%s\n\nPut the device in Bluetooth pairing mode and try Re-pair.' "$name" "$output")"
}

connect_device() {
  mac=$1
  name=$2

  bluetoothctl power on >/dev/null 2>&1 || true

  if device_ready "$mac"; then
    trust_device "$mac" >/dev/null 2>&1 || true
    notify "Bluetooth" "$name is already connected"
    return 0
  fi

  if ! device_has_bond "$mac"; then
    pair_device "$mac" "$name"
  fi

  if output=$(bluetoothctl connect "$mac" 2>&1); then
    trust_device "$mac" >/dev/null 2>&1 || true
    if device_ready "$mac"; then
      notify "Bluetooth" "Connected and trusted $name"
      return 0
    fi

    die_rofi "$(printf 'Bluetooth reported a connection, but %s is not fully paired:\n%s\n\nChoose Re-pair while the device is in pairing mode.' "$name" "$(device_state "$mac")")"
  fi

  first_output=$output
  pair_output=$(bluetoothctl --agent NoInputNoOutput --timeout 30 pair "$mac" 2>&1) || {
    die_rofi "$(printf 'Connect failed:\n%s\n\nPair attempt failed:\n%s' "$first_output" "$pair_output")"
  }
  trust_device "$mac" >/dev/null 2>&1 || true

  if output=$(bluetoothctl connect "$mac" 2>&1); then
    trust_device "$mac" >/dev/null 2>&1 || true
    if device_ready "$mac"; then
      notify "Bluetooth" "Connected and trusted $name"
      return 0
    fi

    die_rofi "$(printf 'Bluetooth reported a connection, but %s is not fully paired:\n%s' "$name" "$(device_state "$mac")")"
  fi

  die_rofi "$(printf 'Connect failed:\n%s\n\nPair attempt:\n%s\n\nSecond connect failed:\n%s' "$first_output" "$pair_output" "$output")"
}

repair_device() {
  mac=$1
  name=$2

  notify "Bluetooth" "Put $name in pairing mode..."
  bluetoothctl power on >/dev/null 2>&1 || true
  bluetoothctl pairable on >/dev/null 2>&1 || true
  bluetoothctl disconnect "$mac" >/dev/null 2>&1 || true
  bluetoothctl remove "$mac" >/dev/null 2>&1 || true
  bluetoothctl --timeout "$scan_seconds" scan on >/dev/null 2>&1 || true

  if ! bluetoothctl info "$mac" >/dev/null 2>&1; then
    new_mac=$(find_device_mac_by_name "$name")
    [ -n "$new_mac" ] && mac=$new_mac
  fi

  if ! bluetoothctl info "$mac" >/dev/null 2>&1; then
    die_rofi "$(printf 'Could not rediscover %s.\n\nHold the controller sync button until it flashes rapidly, then scan and Re-pair again.' "$name")"
  fi

  pair_device "$mac" "$name"

  if output=$(bluetoothctl connect "$mac" 2>&1); then
    trust_device "$mac" >/dev/null 2>&1 || true
    if device_ready "$mac"; then
      notify "Bluetooth" "Paired and connected $name"
      return 0
    fi

    die_rofi "$(printf 'Re-pair did not finish cleanly for %s:\n%s' "$name" "$(device_state "$mac")")"
  fi

  die_rofi "$(printf 'Paired %s, but connect failed:\n%s' "$name" "$output")"
}

scan_devices() {
  notify "Bluetooth" "Scanning for ${scan_seconds}s..."
  bluetoothctl power on >/dev/null 2>&1 || true
  bluetoothctl --timeout "$scan_seconds" scan on >/dev/null 2>&1 || true
}

device_rows() {
  bluetoothctl devices 2>/dev/null \
    | awk '/^Device[[:space:]]+([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}[[:space:]]+/ {
        mac = $2
        $1 = ""
        $2 = ""
        sub(/^[[:space:]]+/, "")
        print mac "\t" $0
      }' \
    | sort -u \
    | while IFS='	' read -r mac name; do
        [ -n "$mac" ] || continue

        connected=$(device_prop "$mac" "Connected")
        paired=$(device_prop "$mac" "Paired")
        bonded=$(device_prop "$mac" "Bonded")
        trusted=$(device_prop "$mac" "Trusted")

        state="[seen]"
        [ "$trusted" = "yes" ] && state="[trusted]"
        { [ "$paired" = "yes" ] || [ "$bonded" = "yes" ]; } && state="[paired]"
        if [ "$connected" = "yes" ]; then
          if [ "$paired" = "yes" ] || [ "$bonded" = "yes" ]; then
            state="[connected]"
          else
            state="[link-only]"
          fi
        fi

        [ -n "$name" ] || name=$(device_name "$mac")
        printf '%s %s  %s\n' "$state" "$name" "$mac"
      done
}

status_label() {
  if ! command -v bluetoothctl >/dev/null 2>&1; then
    printf ' 󰂲 missing '
    return
  fi

  info=$(controller_info)
  if [ -z "$info" ]; then
    printf ' 󰂲 down '
    return
  fi

  powered=$(printf '%s\n' "$info" | awk -F': ' '/^[[:space:]]*Powered:/ { print $2; exit }')
  if [ "$powered" != "yes" ]; then
    printf ' 󰂲 off '
    return
  fi

  connected=$(bluetoothctl devices Connected 2>/dev/null || true)
  if [ -n "$connected" ]; then
    healthy=$(
      printf '%s\n' "$connected" \
        | awk '/^Device[[:space:]]+([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}[[:space:]]+/ { print $2 }' \
        | while read -r mac; do
            [ -n "$mac" ] || continue
            if device_ready "$mac"; then
              printf '%s\t%s\n' "$mac" "$(device_name "$mac")"
            fi
          done
    )

    if [ -n "$healthy" ]; then
      count=$(printf '%s\n' "$healthy" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')
      name=$(printf '%s\n' "$healthy" | sed -n '1s/^[^	]*	//p')
      if [ "$count" = "1" ] && [ -n "$name" ]; then
        short=$(printf '%s' "$name" | cut -c 1-18)
        printf ' 󰂱 %s ' "$short"
      else
        printf ' 󰂱 %s connected ' "$count"
      fi
    else
      printf ' 󰂲 pairing issue '
    fi
    return
  fi

  printf ' 󰂯 on '
}

extract_mac() {
  printf '%s\n' "$1" | grep -Eo '([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}' | tail -n 1
}

show_info() {
  mac=$1
  rofi -e "$(bluetoothctl info "$mac" 2>&1)"
}

device_menu() {
  mac=$1

  wait_for_rofi_transition

  name=$(device_name "$mac")
  connected=$(device_prop "$mac" "Connected")
  trusted=$(device_prop "$mac" "Trusted")

  actions=""
  if device_ready "$mac"; then
    actions="${actions}Disconnect\n"
  elif [ "$connected" = "yes" ]; then
    actions="${actions}Re-pair\nDisconnect\n"
  elif device_has_bond "$mac"; then
    actions="${actions}Connect\nRe-pair\n"
  else
    actions="${actions}Pair and connect\n"
  fi

  if [ "$trusted" = "yes" ]; then
    actions="${actions}Untrust\n"
  else
    actions="${actions}Trust\n"
  fi

  actions="${actions}Remove\nShow info\nBack\n"

  choice=$(
    printf '%b' "$actions" \
      | rofi -dmenu -i -p "$name" -theme-str "listview { lines: 8; }"
  )

  [ -n "${choice:-}" ] || exit 0

  case "$choice" in
    "Connect")
      connect_device "$mac" "$name"
      ;;
    "Pair and connect")
      connect_device "$mac" "$name"
      ;;
    "Re-pair")
      repair_device "$mac" "$name"
      ;;
    "Disconnect")
      run_bt "Disconnected $name" disconnect "$mac"
      ;;
    "Trust")
      run_bt "Trusted $name" trust "$mac"
      ;;
    "Untrust")
      run_bt "Untrusted $name" untrust "$mac"
      ;;
    "Remove")
      run_bt "Removed $name" remove "$mac"
      ;;
    "Show info")
      show_info "$mac"
      ;;
    "Back")
      wait_for_rofi_transition
      show_menu
      ;;
  esac
}

show_menu() {
  require_bluetoothctl

  info=$(controller_info)
  [ -n "$info" ] || die_rofi "Bluetooth service is not available. Start bluetooth.service first."

  powered=$(controller_powered)

  if [ "$powered" = "yes" ]; then
    actions="Scan for devices\nTurn Bluetooth off\n"
  else
    actions="Turn Bluetooth on\n"
  fi

  rows=$(device_rows)
  choice=$(
    {
      printf '%b' "$actions"
      [ -z "$rows" ] || printf '%s\n' "$rows"
    } | rofi -dmenu -i -p "Bluetooth" -theme-str "listview { lines: ${rofi_lines}; }"
  )

  [ -n "${choice:-}" ] || exit 0

  case "$choice" in
    "Scan for devices")
      scan_devices
      wait_for_rofi_transition
      show_menu
      ;;
    "Turn Bluetooth on")
      run_bt "Bluetooth powered on" power on
      wait_for_rofi_transition
      show_menu
      ;;
    "Turn Bluetooth off")
      run_bt "Bluetooth powered off" power off
      ;;
    *)
      mac=$(extract_mac "$choice")
      [ -n "$mac" ] && device_menu "$mac"
      ;;
  esac
}

toggle_power() {
  require_bluetoothctl

  case "$(controller_powered)" in
    yes) run_bt "Bluetooth powered off" power off ;;
    *) run_bt "Bluetooth powered on" power on ;;
  esac
}

case "${1:---menu}" in
  --status) status_label ;;
  --menu) show_menu ;;
  --scan) scan_devices ;;
  --toggle-power) toggle_power ;;
  *) die_rofi "Usage: bluetooth-menu [--status|--menu|--scan|--toggle-power]" ;;
esac
