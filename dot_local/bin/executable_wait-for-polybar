#!/bin/sh

timeout_seconds="${1:-30}"

case "$timeout_seconds" in
  ''|*[!0-9]*)
    timeout_seconds=30
    ;;
esac

attempts=$((timeout_seconds * 10))
uid="$(id -u)"

while [ "$attempts" -gt 0 ]; do
  if pgrep -u "$uid" -x polybar >/dev/null; then
    sleep 0.5
    exit 0
  fi

  attempts=$((attempts - 1))
  sleep 0.1
done

exit 0
